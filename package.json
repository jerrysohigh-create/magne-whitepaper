{
  "name": "magne-whitepaper",
  "version": "1.1.0",
  "private": true,
  "description": "MAGNE.AI bilingual whitepaper v1.1 review site with preserved v1.0 archive",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jerrysohigh-create/magne-whitepaper.git"
  },
  "homepage": "https://github.com/jerrysohigh-create/magne-whitepaper#readme",
  "bugs": {
    "url": "https://github.com/jerrysohigh-create/magne-whitepaper/issues"
  },
  "keywords": [
    "magne",
    "whitepaper",
    "mha",
    "nextjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "content:sync": "node scripts/sync-whitepaper-content.mjs both",
    "prebuild": "npm run content:sync",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:models": "node scripts/test-gen1-model.mjs && node scripts/test-gen1-incentives.mjs",
    "build:pages": "npm run content:sync && node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "linkedom": "0.18.13",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
